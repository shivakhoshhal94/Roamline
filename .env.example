POSTGRES_USER=roamline
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=roamline
DATABASE_URL=postgresql+psycopg://roamline:replace-with-a-local-password@localhost:5432/roamline
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend only. Leave blank until you explicitly enrich candidates.
GEOAPIFY_API_KEY=
GEOAPIFY_MIN_INTERVAL_SECONDS=1
GEOAPIFY_CONNECT_TIMEOUT_SECONDS=15
GEOAPIFY_READ_TIMEOUT_SECONDS=15
GEOAPIFY_PLACES_READ_TIMEOUT_SECONDS=30
GEOAPIFY_WRITE_TIMEOUT_SECONDS=5
GEOAPIFY_POOL_TIMEOUT_SECONDS=5
CANDIDATE_MIN_POPULATION=100000
CANDIDATE_MAX_COUNT=40
FEATURE_STALE_AFTER_DAYS=30

PLACE_RESOLUTION_STALE_AFTER_DAYS=30
ENRICHMENT_LEASE_SECONDS=180

# Optional local pinned BGE snapshot. Compose mounts .tmp/models read-only at /models.
# Set to /models/models--BAAI--bge-small-en-v1.5/snapshots/5c38ec7c405ec4b44b94cc5a9bb96e735b38267a inside Compose.
# Native Python requires the corresponding absolute host path instead. No automatic downloads.
RETRIEVAL_MODEL_PATH=
RETRIEVAL_THREADS=2
