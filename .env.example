POSTGRES_USER=roamline
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=roamline
DATABASE_URL=postgresql+psycopg://roamline:replace-with-a-local-password@localhost:5432/roamline
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend only. Leave blank until you explicitly enrich candidates.
GEOAPIFY_API_KEY=
GEOAPIFY_MIN_INTERVAL_SECONDS=1
GEOAPIFY_CONNECT_TIMEOUT_SECONDS=15
GEOAPIFY_READ_TIMEOUT_SECONDS=15
GEOAPIFY_WRITE_TIMEOUT_SECONDS=5
GEOAPIFY_POOL_TIMEOUT_SECONDS=5
CANDIDATE_MIN_POPULATION=100000
CANDIDATE_MAX_COUNT=40
FEATURE_STALE_AFTER_DAYS=30

BOUNDARY_STALE_AFTER_DAYS=30
ENRICHMENT_LEASE_SECONDS=180
